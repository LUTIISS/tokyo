# Личные медиа-файлы (музыка, мемы, ролики) — кладём локально, в git не тащим.
# Если хочешь закоммитить конкретные файлы, убери нужные строки ниже.
public/audio/tracks/*
!public/audio/tracks/.gitkeep
public/media/billboards/*
!public/media/billboards/.gitkeep
public/media/posters/*
!public/media/posters/.gitkeep

# временные сборки
dist-*/
